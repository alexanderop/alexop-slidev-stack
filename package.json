{
  "name": "alexop-slidev-stack",
  "version": "1.0.0",
  "description": "Reusable Slidev theme, addon, and starter template by @alexop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter slidev-starter dev",
    "build": "pnpm --filter slidev-starter build",
    "export": "pnpm --filter slidev-starter export",
    "research:check": "pnpm --filter slidev-starter research:check",
    "research:test": "pnpm --filter slidev-starter research:test"
  },
  "keywords": [
    "slidev",
    "theme",
    "addon",
    "template"
  ],
  "author": "Alexander Opalic",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.13": ">=3.4.13 <4"
    },
    "patchedDependencies": {
      "gray-matter@4.0.3": "patches/gray-matter@4.0.3.patch"
    }
  }
}
